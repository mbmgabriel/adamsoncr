# Copy to .env on the deployment server, or inject through its secret manager.
# Replace every CHANGE_ME value before starting. Never commit real credentials.
NODE_ENV=production
PORT=3008

# Use a dedicated application login with only the required database permissions.
DB_USERNAME=CHANGE_ME_APP_LOGIN
DB_PASSWORD=CHANGE_ME_ROTATED_DATABASE_PASSWORD
DB_DATABASE=adamson_research
# Use the SQL Server DNS name matching its trusted TLS certificate.
DB_HOST=CHANGE_ME_DATABASE_HOSTNAME
DB_PORT=1433
DB_DIALECT=mssql
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=false

# Public HTTPS endpoints; terminate TLS at the reverse proxy.
# BASE_URL is a hostname; FRONTEND_URL is a complete origin (no trailing slash).
BASE_URL=CHANGE_ME_API_DOMAIN
HTTP_PROTOCOL=https
FRONTEND_URL=https://CHANGE_ME_FRONTEND_DOMAIN

# Generate a fresh secret: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_GENERATED_JWT_SECRET
JWT_LIFETIME=1d

# Configure these if using S3; prefer an attached IAM role for credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_BUCKET_NAME=

# Configure if transactional email is enabled.
MAILER_SEND_API_KEY=
